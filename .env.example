# ---- Runtime -------------------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (replica set). Never commit a real value.
MONGODB_URI=mongodb+srv://AL-Barakah-store:AL-Barakah-store@cluster0.tbkggvt.mongodb.net/?appName=Cluster0
# AL-Barakah-store
# ---- Auth (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") --------
JWT_ACCESS_SECRET=jBQ1MLU0bbOp72yzzHAlt4b4qEpdG0EdTGdyreP3d9VBpoHSf-WgKywjerNk2Vdf

JWT_REFRESH_SECRET=QP8M_U79NlNLeqi5EKuoKG9QojE11u1KzxzA6mGJzrePIuePMsmNRtxOMkXp-SM3

# Pepper for HMAC-hashing OTP codes (must differ from the JWT secrets)
OTP_PEPPER=0u_FWu1WYsqjcnSu8g6_LVG3mZvYKdw-T_c4_nXuYZdVBPJyZHuLvD2uTyNFRx3c
# AES-256-GCM key that encrypts integration secrets stored in MongoDB: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=361f2f13665b2a8bbbe4a1a19bee9a4f91625ae88a86d2531425f37da297e27b
# While rotating: the OLD key(s), comma separated, so existing ciphertexts stay readable until re-encrypted
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
BCRYPT_COST=12
# Access-token lifetimes (minutes) and admin idle window (minutes without a refresh => must sign in again)
CUSTOMER_ACCESS_TTL_MIN=15
ADMIN_IDLE_MIN=10
ADMIN_SESSION_MAX_HOURS=12
CUSTOMER_SESSION_MAX_DAYS=30

# ---- Cookies / CORS (shop.<domain>, admin.<domain>, api.<domain>) --------------------------------------------------
# Refresh-token cookie Domain (leave empty for host-only cookies in local dev)
COOKIE_DOMAIN=.example.com
# Comma-separated exact origins allowed to call the API with credentials
CORS_ORIGINS=https://shop.example.com,https://admin.example.com
# Where admin invite links point (set-password page)
ADMIN_APP_URL=https://admin.example.com
# Number of trusted reverse-proxy hops (Vercel = 1)
TRUST_PROXY_HOPS=1

# ---- Mail (ONE verified sender; TLS verification is always on) -----------------------------------------------------
# smtp | memory (memory is refused in production)
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=mujs uvke gavw ksyu

# SMTP_FROM="Al Barakah <no-reply@example.com>"

MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mosaraf.cse8.bu@gmail.com
SMTP_PASS=mujsuvkegavwksyu
SMTP_FROM="Al Barakah Admin <mosaraf.cse8.bu@gmail.com>"


# Owner and customer order e-mails. Off unless exactly "true". Telegram, Facebook CAPI, and courier stay on ENABLE_LIVE_INTEGRATIONS.
# The owner message goes to the active super_admin account's e-mail (the address OTP is sent to). SUPER_ADMIN_EMAIL is used only when that account does not exist yet.
ENABLE_ORDER_EMAILS=false

